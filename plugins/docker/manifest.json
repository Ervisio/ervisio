{
  "author": "LinuxAdmin team",
  "capabilities": {
    "commands": [
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "argv": [
          "docker",
          "ps",
          "-a",
          "--no-trunc",
          "--format",
          "{{json .}}"
        ],
        "description": "List containers",
        "name": "ps"
      },
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "argv": [
          "docker",
          "images",
          "--format",
          "{{json .}}"
        ],
        "description": "List images",
        "name": "images"
      },
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "args": [
          {
            "maxLen": 128,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
          }
        ],
        "argv": [
          "docker",
          "start",
          "{0}"
        ],
        "description": "Start a container",
        "name": "start"
      },
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "args": [
          {
            "maxLen": 128,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
          }
        ],
        "argv": [
          "docker",
          "stop",
          "{0}"
        ],
        "description": "Stop a container",
        "name": "stop",
        "timeoutSec": 60
      },
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "args": [
          {
            "maxLen": 128,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
          }
        ],
        "argv": [
          "docker",
          "restart",
          "{0}"
        ],
        "description": "Restart a container",
        "name": "restart",
        "timeoutSec": 90
      },
      {
        "admin": true,
        "adminUnlessGroup": "docker",
        "args": [
          {
            "maxLen": 128,
            "pattern": "[a-zA-Z0-9][a-zA-Z0-9_.-]*"
          }
        ],
        "argv": [
          "docker",
          "logs",
          "--tail",
          "200",
          "--timestamps",
          "{0}"
        ],
        "description": "Show the last 200 log lines of a container",
        "name": "logs"
      }
    ],
    "files": {
      "read": [],
      "write": []
    },
    "network": [],
    "sockets": [
      "/var/run/docker.sock"
    ]
  },
  "color": "file",
  "contributes": {
    "pages": [
      {
        "icon": "server",
        "id": "docker",
        "title": "Docker"
      }
    ],
    "snippets": [
      {
        "command": "docker ps",
        "name": "docker ps"
      }
    ],
    "widgets": [
      {
        "icon": "server",
        "id": "containers",
        "title": "Containers"
      }
    ]
  },
  "description": "Containers, images and logs. Start, stop and restart from the browser.",

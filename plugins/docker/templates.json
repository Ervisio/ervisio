  {
   "id": "nextcloud",
   "name": "Nextcloud",
   "hue": "file",
   "category": "Files",
   "type": "stack",
   "featured": true,
   "description": "Your own cloud for files, calendar and contacts, with a MariaDB database.",
   "website": "https://nextcloud.com",
   "needs": {
    "ports": [
     8080
    ],
    "ram": "1 GB",
    "containers": 2
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Port on this server",
     "default": "8080",
     "type": "port",
     "required": true
    },
    {
     "name": "MYSQL_ROOT_PASSWORD",
     "label": "Database root password",
     "default": "",
     "type": "password",
     "required": true,
     "generate": true
    },
    {
     "name": "MYSQL_PASSWORD",
     "label": "Database password",
     "default": "",
     "type": "password",
     "required": true,
     "generate": true
    },
    {
     "name": "NEXTCLOUD_ADMIN_USER",
     "label": "Admin user",
     "default": "admin",
     "type": "text",
     "required": true
    },
    {
     "name": "NEXTCLOUD_ADMIN_PASSWORD",
     "label": "Admin password",
     "default": "",
     "type": "password",
     "required": true,
     "generate": true
    }
   ],
   "compose": "services:\n  db:\n    image: mariadb:11\n    restart: unless-stopped\n    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW\n    volumes:\n      - db:/var/lib/mysql\n    environment:\n      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}\n      MYSQL_PASSWORD: ${MYSQL_PASSWORD}\n      MYSQL_DATABASE: nextcloud\n      MYSQL_USER: nextcloud\n  app:\n    image: nextcloud:stable\n    restart: unless-stopped\n    depends_on:\n      - db\n    ports:\n      - \"${WEB_PORT}:80\"\n    volumes:\n      - nextcloud:/var/www/html\n    environment:\n      MYSQL_HOST: db\n      MYSQL_DATABASE: nextcloud\n      MYSQL_USER: nextcloud\n      MYSQL_PASSWORD: ${MYSQL_PASSWORD}\n      NEXTCLOUD_ADMIN_USER: ${NEXTCLOUD_ADMIN_USER}\n      NEXTCLOUD_ADMIN_PASSWORD: ${NEXTCLOUD_ADMIN_PASSWORD}\nvolumes:\n  db:\n  nextcloud:\n",
   "source": "linuxadmin"
  },
  {
   "id": "immich",
   "name": "Immich",
   "hue": "plg",
   "category": "Photos",
   "type": "stack",
   "featured": true,
   "description": "Back up photos and videos from your phone, browse them on a map and find faces.",
   "website": "https://immich.app",
   "needs": {
    "ports": [
     2283
    ],
    "ram": "4 GB",
    "disk": "Depends on your library",
    "containers": 4,
    "note": "Based on the official compose file. The machine learning container is large."
   },
   "variables": [
    {
     "name": "IMMICH_PORT",
     "label": "Port on this server",
     "default": "2283",
     "type": "port",
     "required": true
    },
    {
     "name": "UPLOAD_LOCATION",
     "label": "Folder for photos and videos",
     "default": "/srv/immich/library",
     "type": "path",
     "required": true
    },
    {
     "name": "DB_DATA_LOCATION",
     "label": "Folder for the database",
     "default": "/srv/immich/postgres",
     "type": "path",
     "required": true,
     "hint": "Keep this on a local disk, not a network share."
    },
    {
     "name": "DB_PASSWORD",
     "label": "Database password",
     "default": "",
     "type": "password",
     "required": true,
     "hint": "Letters and digits only.",
     "generate": true
    },
    {
     "name": "TZ",
     "label": "Time zone",
     "default": "Europe/Rome",
     "type": "text",
     "hint": "For example Europe/Rome or America/New_York."
    },
    {
     "name": "IMMICH_VERSION",
     "label": "Version",
     "default": "release",
     "type": "text",
     "required": true,
     "hint": "release is the latest stable one."
    }
   ],
   "compose": "services:\n  immich-server:\n    container_name: immich_server\n    image: ghcr.io/immich-app/immich-server:${IMMICH_VERSION}\n    volumes:\n      - ${UPLOAD_LOCATION}:/data\n      - /etc/localtime:/etc/localtime:ro\n    env_file:\n      - .env\n    ports:\n      - \"${IMMICH_PORT}:2283\"\n    depends_on:\n      - redis\n      - database\n    restart: always\n  immich-machine-learning:\n    container_name: immich_machine_learning\n    image: ghcr.io/immich-app/immich-machine-learning:${IMMICH_VERSION}\n    volumes:\n      - model-cache:/cache\n    env_file:\n      - .env\n    restart: always\n  redis:\n    container_name: immich_redis\n    image: docker.io/valkey/valkey:8-bookworm\n    healthcheck:\n      test: redis-cli ping || exit 1\n    restart: always\n  database:\n    container_name: immich_postgres\n    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0\n    environment:\n      POSTGRES_PASSWORD: ${DB_PASSWORD}\n      POSTGRES_USER: postgres\n      POSTGRES_DB: immich\n      POSTGRES_INITDB_ARGS: \"--data-checksums\"\n    volumes:\n      - ${DB_DATA_LOCATION}:/var/lib/postgresql/data\n    shm_size: 128mb\n    restart: always\nvolumes:\n  model-cache:\n",
   "source": "linuxadmin"
  },

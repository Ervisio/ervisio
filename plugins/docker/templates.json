     "default": "/srv/paperless/consume",
     "type": "path",
     "required": true,
     "hint": "Files put here are imported."
    },
    {
     "name": "PAPERLESS_URL",
     "label": "Address people will use",
     "default": "http://localhost:8000",
     "type": "text",
     "required": true
    },
    {
     "name": "PAPERLESS_SECRET_KEY",

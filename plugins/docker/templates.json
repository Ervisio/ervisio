  {
   "id": "minio",
   "name": "MinIO",
   "hue": "svc",
   "category": "Files",
   "type": "container",
   "description": "S3-compatible object storage on your own disk.",
   "website": "https://min.io",
   "needs": {
    "ports": [
     9000,
     9001
    ],
    "ram": "300 MB"
   },
   "variables": [
    {
     "name": "API_PORT",
     "label": "S3 API port",
     "default": "9000",
     "type": "port",
     "required": true
    },
    {
     "name": "CONSOLE_PORT",
     "label": "Web console port",
     "default": "9001",
     "type": "port",
     "required": true
    },
    {
     "name": "MINIO_ROOT_USER",
     "label": "Root user",
     "default": "minioadmin",
     "type": "text",
     "required": true
    },
    {
     "name": "MINIO_ROOT_PASSWORD",
     "label": "Root password",
     "default": "",
     "type": "password",
     "required": true,
     "hint": "At least 8 characters.",
     "generate": true
    },
    {
     "name": "DATA_DIR",
     "label": "Data folder",
     "default": "/srv/minio",
     "type": "path",
     "required": true
    }
   ],
   "container": {
    "image": "quay.io/minio/minio:latest",
    "ports": [
     {
      "host": "${API_PORT}",

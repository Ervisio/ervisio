{
 "version": 1,
 "name": "LinuxAdmin catalog",
 "templates": [
  {
   "id": "nginx",
   "name": "nginx",
   "hue": "term",
   "category": "Web",
   "type": "container",
   "description": "Fast web server and reverse proxy. Serves the files of a folder.",
   "website": "https://nginx.org",
   "needs": {
    "ports": [
     8080
    ],
    "ram": "20 MB"
   },
   "variables": [
    {
     "name": "HTTP_PORT",
     "label": "Port on this server",
     "default": "8080",
     "type": "port",
     "required": true
    },
    {
     "name": "HTML_DIR",
     "label": "Folder with the site",
     "default": "/srv/www",
     "type": "path",
     "required": true,
     "hint": "Files in this folder are served read only."
    }
   ],
   "container": {
    "image": "nginx:stable-alpine",
    "ports": [
     {
      "host": "${HTTP_PORT}",
      "container": "80",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "${HTML_DIR}",
      "target": "/usr/share/nginx/html",
      "readOnly": true
     }
    ],
    "env": [],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "caddy",
   "name": "Caddy",
   "hue": "file",
   "category": "Web",
   "type": "container",
   "description": "Web server that gets and renews HTTPS certificates by itself.",
   "website": "https://caddyserver.com",
   "needs": {
    "ports": [
     80,
     443
    ],
    "ram": "40 MB",
    "note": "Ports 80 and 443 must be free."
   },
   "variables": [
    {
     "name": "HTTP_PORT",
     "label": "HTTP port",
     "default": "80",
     "type": "port",
     "required": true
    },
    {
     "name": "HTTPS_PORT",
     "label": "HTTPS port",
     "default": "443",
     "type": "port",
     "required": true
    },
    {
     "name": "SITE_DIR",
     "label": "Folder with the site",
     "default": "/srv/caddy/site",
     "type": "path",
     "required": true
    }
   ],
   "container": {
    "image": "caddy:2-alpine",
    "ports": [
     {
      "host": "${HTTP_PORT}",
      "container": "80",
      "proto": "tcp"
     },
     {
      "host": "${HTTPS_PORT}",
      "container": "443",
      "proto": "tcp"
     },
     {
      "host": "${HTTPS_PORT}",
      "container": "443",
      "proto": "udp"
     }
    ],
    "volumes": [
     {
      "source": "${SITE_DIR}",
      "target": "/usr/share/caddy"
     },
     {
      "source": "caddy-data",
      "target": "/data"
     },
     {
      "source": "caddy-config",
      "target": "/config"
     }
    ],
    "env": [],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "jellyfin",
   "name": "Jellyfin",
   "hue": "sw",
   "category": "Media",
   "type": "container",
   "featured": true,
   "description": "Stream your movies, shows and music to any device.",
   "website": "https://jellyfin.org",
   "needs": {
    "ports": [
     8096
    ],
    "ram": "1 GB",
    "note": "Transcoding uses a lot of CPU."
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Port on this server",
     "default": "8096",
     "type": "port",
     "required": true
    },
    {
     "name": "MEDIA_DIR",
     "label": "Folder with your media",
     "default": "/srv/media",
     "type": "path",
     "required": true,
     "hint": "Mounted read only at /media."
    },
    {
     "name": "TZ",
     "label": "Time zone",
     "default": "Europe/Rome",
     "type": "text",
     "hint": "For example Europe/Rome or America/New_York."
    }
   ],
   "container": {
    "image": "jellyfin/jellyfin:latest",
    "ports": [
     {
      "host": "${WEB_PORT}",
      "container": "8096",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "jellyfin-config",
      "target": "/config"
     },
     {
      "source": "jellyfin-cache",
      "target": "/cache"
     },
     {
      "source": "${MEDIA_DIR}",
      "target": "/media",
      "readOnly": true
     }
    ],
    "env": [
     {
      "key": "TZ",
      "value": "${TZ}"
     }
    ],
    "restart": "unless-stopped"
   },
   "source": "linuxadmin"
  },
  {
   "id": "vaultwarden",
   "name": "Vaultwarden",
   "hue": "term",
   "category": "Security",
   "type": "container",
   "featured": true,
   "description": "Password manager that works with the Bitwarden apps and browser extensions.",
   "website": "https://github.com/dani-garcia/vaultwarden",
   "needs": {
    "ports": [
     8222
    ],
    "ram": "30 MB",
    "note": "The apps need HTTPS: put it behind a reverse proxy."
   },
   "variables": [
    {
     "name": "DOMAIN",
     "label": "Address people will use",
     "default": "https://vault.example.com",
     "type": "text",
     "required": true,
     "hint": "Needed for the apps and for e-mail links."
    },
    {
     "name": "WEB_PORT",
     "label": "Port on this server",
     "default": "8222",
     "type": "port",
     "required": true
    },
    {
     "name": "DATA_DIR",
     "label": "Data folder",
     "default": "/srv/vaultwarden",
     "type": "path",
     "required": true
    },
    {
     "name": "ADMIN_TOKEN",
     "label": "Admin token",
     "default": "",
     "type": "password",
     "required": true,
     "hint": "Opens the /admin page. Generated for you; keep it.",
     "generate": true
    },
    {
     "name": "SIGNUPS_ALLOWED",
     "label": "Allow new sign-ups",
     "default": "true",
     "type": "bool"
    }
   ],
   "container": {
    "image": "vaultwarden/server:latest",
    "ports": [
     {
      "host": "${WEB_PORT}",
      "container": "80",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "${DATA_DIR}",
      "target": "/data"
     }
    ],
    "env": [
     {
      "key": "DOMAIN",
      "value": "${DOMAIN}"
     },
     {
      "key": "ADMIN_TOKEN",
      "value": "${ADMIN_TOKEN}"
     },
     {
      "key": "SIGNUPS_ALLOWED",
      "value": "${SIGNUPS_ALLOWED}"
     }
    ],
    "restart": "unless-stopped"
   },
   "source": "linuxadmin"
  },
  {
   "id": "gitea",
   "name": "Gitea",
   "hue": "term",
   "category": "Development",
   "type": "container",
   "description": "Lightweight Git server with issues and pull requests.",
   "website": "https://about.gitea.com",
   "needs": {
    "ports": [
     3000,
     2222
    ],
    "ram": "200 MB"
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Web port",
     "default": "3000",
     "type": "port",
     "required": true
    },
    {
     "name": "SSH_PORT",
     "label": "SSH port for git",
     "default": "2222",
     "type": "port",
     "required": true
    }
   ],
   "container": {
    "image": "gitea/gitea:1",
    "ports": [
     {
      "host": "${WEB_PORT}",
      "container": "3000",
      "proto": "tcp"
     },
     {
      "host": "${SSH_PORT}",
      "container": "22",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "gitea-data",
      "target": "/data"
     }
    ],
    "env": [
     {
      "key": "USER_UID",
      "value": "1000"
     },
     {
      "key": "USER_GID",
      "value": "1000"
     }
    ],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "uptime-kuma",
   "name": "Uptime Kuma",
   "hue": "term",
   "category": "Monitoring",
   "type": "container",
   "featured": true,
   "description": "Checks your sites and services and alerts you when they go down.",
   "website": "https://uptime.kuma.pet",
   "needs": {
    "ports": [
     3001
    ],
    "ram": "100 MB"
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Port on this server",
     "default": "3001",
     "type": "port",
     "required": true
    }
   ],
   "container": {
    "image": "louislam/uptime-kuma:1",
    "ports": [
     {
      "host": "${WEB_PORT}",
      "container": "3001",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "uptime-kuma",
      "target": "/app/data"
     }
    ],
    "env": [],
    "restart": "unless-stopped"
   },
   "source": "linuxadmin"
  },
  {
   "id": "pihole",
   "name": "Pi-hole",
   "hue": "svc",
   "category": "Network",
   "type": "container",
   "description": "Blocks ads and trackers for every device on your network.",
   "website": "https://pi-hole.net",
   "needs": {
    "ports": [
     53,
     8081
    ],
    "ram": "100 MB",
    "note": "Port 53 is often used by systemd-resolved. Free it first."
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Web port",
     "default": "8081",
     "type": "port",
     "required": true
    },
    {
     "name": "WEB_PASSWORD",
     "label": "Admin password",
     "default": "",
     "type": "password",
     "required": true,
     "hint": "Generated for you; keep it.",
     "generate": true
    },
    {
     "name": "TZ",
     "label": "Time zone",
     "default": "Europe/Rome",
     "type": "text",
     "hint": "For example Europe/Rome or America/New_York."
    }
   ],
   "container": {
    "image": "pihole/pihole:latest",
    "ports": [
     {
      "host": "53",
      "container": "53",
      "proto": "tcp"
     },
     {
      "host": "53",
      "container": "53",
      "proto": "udp"
     },
     {
      "host": "${WEB_PORT}",
      "container": "80",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "pihole-etc",
      "target": "/etc/pihole"
     }
    ],
    "env": [
     {
      "key": "TZ",
      "value": "${TZ}"
     },
     {
      "key": "FTLCONF_webserver_api_password",
      "value": "${WEB_PASSWORD}"
     },
     {
      "key": "FTLCONF_dns_listeningMode",
      "value": "all"
     }
    ],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "adguardhome",
   "name": "AdGuard Home",
   "hue": "file",
   "category": "Network",
   "type": "container",
   "description": "Network-wide ad blocker and DNS server with a clean web page.",
   "website": "https://adguard.com/adguard-home.html",
   "needs": {
    "ports": [
     53,
     3000
    ],
    "ram": "100 MB",
    "note": "Port 53 is often used by systemd-resolved. Free it first. The setup page is on port 3000."
   },
   "variables": [
    {
     "name": "SETUP_PORT",
     "label": "Setup and web port",
     "default": "3000",
     "type": "port",
     "required": true
    }
   ],
   "container": {
    "image": "adguard/adguardhome:latest",
    "ports": [
     {
      "host": "53",
      "container": "53",
      "proto": "tcp"
     },
     {
      "host": "53",
      "container": "53",
      "proto": "udp"
     },
     {
      "host": "${SETUP_PORT}",
      "container": "3000",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "adguard-work",
      "target": "/opt/adguardhome/work"
     },
     {
      "source": "adguard-conf",
      "target": "/opt/adguardhome/conf"
     }
    ],
    "env": [],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "homeassistant",
   "name": "Home Assistant",
   "hue": "usr",
   "category": "Home",
   "type": "container",
   "featured": true,
   "description": "Control lights, sensors and automations at home.",
   "website": "https://www.home-assistant.io",
   "needs": {
    "ports": [
     8123
    ],
    "ram": "500 MB",
    "note": "Uses the host network, so it finds devices on your LAN."
   },
   "variables": [
    {
     "name": "CONFIG_DIR",
     "label": "Config folder",
     "default": "/srv/homeassistant",
     "type": "path",
     "required": true
    },
    {
     "name": "TZ",
     "label": "Time zone",
     "default": "Europe/Rome",
     "type": "text",
     "hint": "For example Europe/Rome or America/New_York."
    }
   ],
   "container": {
    "image": "ghcr.io/home-assistant/home-assistant:stable",
    "ports": [],
    "volumes": [
     {
      "source": "${CONFIG_DIR}",
      "target": "/config"
     },
     {
      "source": "/etc/localtime",
      "target": "/etc/localtime",
      "readOnly": true
     }
    ],
    "env": [
     {
      "key": "TZ",
      "value": "${TZ}"
     }
    ],
    "restart": "unless-stopped",
    "network": "host"
   },
   "source": "linuxadmin"
  },
  {
   "id": "postgres",
   "name": "PostgreSQL",
   "hue": "file",
   "category": "Database",
   "type": "container",
   "description": "The relational database many apps ask for.",
   "website": "https://www.postgresql.org",
   "needs": {
    "ports": [
     5432
    ],
    "ram": "200 MB"
   },
   "variables": [
    {
     "name": "DB_PORT",
     "label": "Port on this server",
     "default": "5432",
     "type": "port",
     "required": true
    },
    {
     "name": "POSTGRES_USER",
     "label": "User",
     "default": "postgres",
     "type": "text",
     "required": true
    },
    {
     "name": "POSTGRES_PASSWORD",
     "label": "Password",
     "default": "",
     "type": "password",
     "required": true,
     "generate": true
    },
    {
     "name": "POSTGRES_DB",
     "label": "Database",
     "default": "app",
     "type": "text",
     "required": true
    }
   ],
   "container": {
    "image": "postgres:17",
    "ports": [
     {
      "host": "${DB_PORT}",
      "container": "5432",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "postgres-data",
      "target": "/var/lib/postgresql/data"
     }
    ],
    "env": [
     {
      "key": "POSTGRES_USER",
      "value": "${POSTGRES_USER}"
     },
     {
      "key": "POSTGRES_PASSWORD",
      "value": "${POSTGRES_PASSWORD}"
     },
     {
      "key": "POSTGRES_DB",
      "value": "${POSTGRES_DB}"
     }
    ],
    "restart": "unless-stopped"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "redis",
   "name": "Redis",
   "hue": "svc",
   "category": "Database",
   "type": "container",
   "description": "In-memory store for caches and queues, saved to disk.",
   "website": "https://redis.io",
   "needs": {
    "ports": [
     6379
    ],
    "ram": "50 MB"
   },
   "variables": [
    {
     "name": "REDIS_PORT",
     "label": "Port on this server",
     "default": "6379",
     "type": "port",
     "required": true
    },
    {
     "name": "REDIS_PASSWORD",
     "label": "Password",
     "default": "",
     "type": "password",
     "required": true,
     "generate": true
    }
   ],
   "container": {
    "image": "redis:7-alpine",
    "ports": [
     {
      "host": "${REDIS_PORT}",
      "container": "6379",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "redis-data",
      "target": "/data"
     }
    ],
    "env": [],
    "restart": "unless-stopped",
    "command": "redis-server --appendonly yes --requirepass ${REDIS_PASSWORD}"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {

  {
   "id": "wg-easy",
   "name": "WireGuard Easy",
   "hue": "svc",
   "category": "Network",
   "type": "stack",
   "description": "A WireGuard VPN server with a web page to add devices.",
   "website": "https://github.com/wg-easy/wg-easy",
   "needs": {
    "ports": [
     51820,
     51821
    ],
    "ram": "50 MB",
    "note": "Forward UDP 51820 on your router. The web page is plain HTTP: keep it on a trusted network."
   },
   "variables": [
    {
     "name": "VPN_PORT",
     "label": "VPN port (UDP)",
     "default": "51820",
     "type": "port",
     "required": true
    },
    {
     "name": "WEB_PORT",
     "label": "Web port",
     "default": "51821",
     "type": "port",
     "required": true
    }
   ],
   "compose": "services:\n  wg-easy:\n    image: ghcr.io/wg-easy/wg-easy:15\n    restart: unless-stopped\n    environment:\n      INSECURE: \"true\"\n    volumes:\n      - etc_wireguard:/etc/wireguard\n      - /lib/modules:/lib/modules:ro\n    ports:\n      - \"${VPN_PORT}:51820/udp\"\n      - \"${WEB_PORT}:51821/tcp\"\n    cap_add:\n      - NET_ADMIN\n      - SYS_MODULE\n    sysctls:\n      - net.ipv4.ip_forward=1\n      - net.ipv4.conf.all.src_valid_mark=1\n      - net.ipv6.conf.all.disable_ipv6=0\n      - net.ipv6.conf.all.forwarding=1\n      - net.ipv6.conf.default.forwarding=1\nvolumes:\n  etc_wireguard:\n",
   "featured": false,
   "source": "linuxadmin"
  },

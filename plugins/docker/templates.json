      "host": "${CONSOLE_PORT}",
      "container": "9001",
      "proto": "tcp"
     }
    ],
    "volumes": [
     {
      "source": "${DATA_DIR}",
      "target": "/data"
     }
    ],
    "env": [
     {
      "key": "MINIO_ROOT_USER",
      "value": "${MINIO_ROOT_USER}"
     },
     {
      "key": "MINIO_ROOT_PASSWORD",
      "value": "${MINIO_ROOT_PASSWORD}"
     }
    ],
    "restart": "unless-stopped",
    "command": "server /data --console-address :9001"
   },
   "featured": false,
   "source": "linuxadmin"
  },
  {
   "id": "syncthing",
   "name": "Syncthing",
   "hue": "file",
   "category": "Files",
   "type": "container",
   "description": "Syncs folders between your devices, peer to peer.",
   "website": "https://syncthing.net",
   "needs": {
    "ports": [
     8384,
     22000,
     21027
    ],
    "ram": "150 MB"
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Web port",

     8000
    ],
    "ram": "1.5 GB",
    "containers": 3
   },
   "variables": [
    {
     "name": "WEB_PORT",
     "label": "Port on this server",
     "default": "8000",
     "type": "port",
     "required": true
    },
    {
     "name": "CONSUME_DIR",

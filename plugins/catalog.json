      "id": "proxmox",
      "name": "Proxmox",
      "version": "0.7.0",
      "author": "Ervisio team",
      "description": "Manage VMs and containers on a Proxmox node.",
      "icon": "server",
      "color": "usr",
      "category": "Containers",
      "verified": true,
      "installs": 12000,
      "featured": true,
      "notes": "Start, stop and snapshot your VMs from the same place as the rest of your servers.",
      "source": "https://plugins.example.invalid/proxmox-0.7.0.tar.gz",
      "capabilities": {
        "commands": [
          {
            "name": "vms",
            "description": "List VMs",
            "argv": [
              "qm",
              "list"
            ],
            "admin": true
          },
          {
            "name": "start",
            "description": "Start a VM",
            "argv": [
              "qm",
              "start",
              "{0}"
            ],
            "args": [
              {
                "pattern": "[0-9]{1,6}",
                "maxLen": 6
              }
            ],
            "admin": true
          },
          {
            "name": "stop",
            "description": "Stop a VM",
            "argv": [
              "qm",
              "stop",
              "{0}"
            ],
            "args": [
              {
                "pattern": "[0-9]{1,6}",
                "maxLen": 6
              }
            ],
            "admin": true
          },
          {
            "name": "snapshot",
            "description": "Snapshot a VM",
            "argv": [
              "qm",
              "snapshot",
              "{0}",
              "{1}"
            ],
            "args": [
              {
                "pattern": "[0-9]{1,6}",
                "maxLen": 6
              },
              {
                "pattern": "[a-zA-Z0-9][a-zA-Z0-9_.-]*",
                "maxLen": 40
              }
            ],
            "admin": true
          }
        ],
        "files": {
          "read": [],
          "write": []
        },
        "sockets": [
          "/var/run/pveproxy.sock"
        ],
        "network": [
          "localhost"

# pacman install script of the linuxadmin and linuxadmin-bin packages.

post_install() {
	cat <<'MSG'
==> Start LinuxAdmin and enable it at boot:
      systemctl enable --now linuxadmin
    then open https://<this host>:9090 (self-signed certificate) and sign in
    with a Linux account.
==> Administrator rights use sudo: members of the 'wheel' group need the
    "%wheel ALL=(ALL:ALL) ALL" rule, which Arch ships commented out
    (enable it with visudo).
==> Updates come with pacman; LinuxAdmin's own self-update is off.
MSG
}

post_upgrade() {
	# Restarts the service if it runs (deferred until pacman has finished
	# when pacman was started from LinuxAdmin itself).
	/usr/lib/linuxadmin/package-service restart
}

pre_remove() {
	systemctl disable linuxadmin.service >/dev/null 2>&1 || true
	/usr/lib/linuxadmin/package-service stop
}

post_remove() {
	echo "==> /etc/linuxadmin (configuration, TLS certificate) and /var/lib/linuxadmin (installed plugins) were kept."
}

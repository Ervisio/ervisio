# Maintainer: Fonlogen <info.fonlogen@gmail.com>
#
# LinuxAdmin built from the tagged source. Prebuilt binaries: the
# "linuxadmin-bin" package.

pkgname=linuxadmin
pkgver=0.1.0
pkgrel=1
pkgdesc='Web console for managing a Linux server from the browser'
arch=('x86_64' 'aarch64')
url='https://github.com/Fonlogen/LinuxAdmin'
license=('LicenseRef-Unlicensed')
depends=('glibc' 'pam' 'sudo' 'systemd')
makedepends=('go' 'npm')
conflicts=('linuxadmin-bin')
backup=('etc/pam.d/linuxadmin')
install=linuxadmin.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/Fonlogen/LinuxAdmin/archive/refs/tags/v$pkgver.tar.gz"
        'linuxadmin.pam'
        'package-service.sh')
sha256sums=('30c5f887674c682b3c2b481b555e33284d4d5f29631ef590aff2771907a7ecdb' 'e23b5824cb2069f655bc3644bc54236e149f21a9e7e12c9f4c2d72d40e66a2e3' '31c139d1a22e23a9f64cb0ba92d669f2d31a1e67ca52c923a504fe5ea1f8b9fb')

_src() { printf '%s' "$srcdir/LinuxAdmin-$pkgver"; }

prepare() {
	cd "$(_src)/web"
	npm ci --no-audit --no-fund --cache "$srcdir/npm-cache"
	cd "$(_src)/server"
	export GOPATH="$srcdir/gopath" GOFLAGS='-modcacherw'
	go mod download
}

build() {
	cd "$(_src)/web"
	npm run build

	cd "$(_src)/server"
	export GOPATH="$srcdir/gopath"
	export CGO_ENABLED=1
	export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
	go build -ldflags "-linkmode=external -X github.com/Fonlogen/LinuxAdmin/server/internal/brand.Version=$pkgver" \
		-o bin/ ./cmd/linuxadmind ./cmd/linuxadmin-bridge
}

check() {
	cd "$(_src)/server"
	export GOPATH="$srcdir/gopath" GOFLAGS='-mod=readonly -modcacherw'
	test "$(bin/linuxadmind --version)" = "$pkgver"
	go test ./...
}

package() {
	cd "$(_src)"
	install -Dm755 server/bin/linuxadmind "$pkgdir/usr/bin/linuxadmind"
	install -Dm755 server/bin/linuxadmin-bridge "$pkgdir/usr/lib/linuxadmin/linuxadmin-bridge"
	install -Dm755 "$srcdir/package-service.sh" "$pkgdir/usr/lib/linuxadmin/package-service"
	# Self-update stays off: pacman installs new versions.
	printf 'pacman\n' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/linuxadmin/managed"

	install -d "$pkgdir/usr/share/linuxadmin/plugins"
	cp -r --no-preserve=ownership web/dist "$pkgdir/usr/share/linuxadmin/web"
	cp -r --no-preserve=ownership plugins/docker "$pkgdir/usr/share/linuxadmin/plugins/docker"
	chmod -R u+rwX,go+rX,go-w "$pkgdir/usr/share/linuxadmin"

	install -Dm644 packaging/linuxadmin.service "$pkgdir/usr/lib/systemd/system/linuxadmin.service"
	install -Dm644 "$srcdir/linuxadmin.pam" "$pkgdir/etc/pam.d/linuxadmin"
	install -dm755 "$pkgdir/etc/linuxadmin" "$pkgdir/var/lib/linuxadmin"
}

#!/bin/sh
# postrm of the ervisio .deb (nfpm), as dh_installsystemd generates it.
# Purge also removes the configuration, the TLS certificate and installed plugins.
set -e
unit=ervisio.service
if [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
	deb-systemd-helper mask $unit >/dev/null || true
fi
if [ "$1" = purge ]; then
	if [ -x /usr/bin/deb-systemd-helper ]; then
		deb-systemd-helper purge $unit >/dev/null || true
		deb-systemd-helper unmask $unit >/dev/null || true
	fi
	rm -rf /etc/ervisio /var/lib/ervisio
fi
exit 0

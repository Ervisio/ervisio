#%PAM-1.0
# PAM service for LinuxAdmin sign-in (installed as /etc/pam.d/linuxadmin).
# Arch Linux / Fedora-style stacks; on Debian/Ubuntu use @include common-auth,
# @include common-account and @include common-session instead.
# The session stack runs around every user bridge (pam_limits, pam_loginuid,
# pam_systemd...), opened by linuxadmind's root session helper.
auth      include   system-login
account   include   system-login
session   include   system-login
